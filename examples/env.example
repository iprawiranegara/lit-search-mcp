# Optional settings for lit-search-mcp. Copy to ~/.config/lit-search-mcp/env (Linux
# systemd example) or export them in the shell before running lit-search-stack.
# Every line is optional; the defaults work without any of them.

# ── addresses (router and launcher) ─────────────────────────────────────────
# LIT_SEARCH_HOST=127.0.0.1
# LIT_SEARCH_PORT=28502
# LIT_SEARCH_PATH=/mcp
# LIT_SEARCH_PORT_OPENALEX=28495
# LIT_SEARCH_PORT_ARXIV=28496
# LIT_SEARCH_PORT_PUBMED=28497
# LIT_SEARCH_PORT_CROSSREF=28498
# LIT_SEARCH_PORT_GUTENBERG=28499
# LIT_SEARCH_PORT_OPENLIBRARY=28500
# LIT_SEARCH_PORT_INTERNET_ARCHIVE=28501
# Point the router at an upstream you run elsewhere (overrides host/port):
# LIT_SEARCH_URL_PUBMED=http://127.0.0.1:9000/mcp

# ── upstream server settings (read by the cyanheads servers themselves) ─────
# Crossref "polite pool": a contact address gets better rate limits.
# CROSSREF_MAILTO=you@example.org
# NCBI E-utilities: an API key raises PubMed from 3 to 10 requests per second.
# NCBI_API_KEY=
# NCBI_ADMIN_EMAIL=you@example.org
# OpenAlex: optional key.
# OPENALEX_API_KEY=
